generator client {
  provider  = "prisma-client-py"
  interface = "asyncio"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Student authentication (separate table)
model Student {
  id              String            @id @default(uuid())
  student_code    String            @unique
  email           String            @unique
  name            String
  class_          String?           @map("class")
  hashed_password String
  created_at      DateTime          @default(now())
  is_active       Boolean           @default(true)
  enrollments     ClassEnrollment[]

  @@index([email])
}

// Teacher & Admin authentication (with role-based permissions)
model Teacher {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String
  hashed_password String
  created_at      DateTime       @default(now())
  is_active       Boolean        @default(true)
  role_id         String?
  role            Role?          @relation(fields: [role_id], references: [id])
  courses         Course[]
  exams           Exam[]
  class_teachers  ClassTeacher[]

  @@index([email])
  @@index([role_id])
}

// Permission-based RBAC
model Permission {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "course:create", "assignment:grade"
  roles     Role[]
}

model Role {
  id           String      @id @default(uuid())
  name         String      @unique // "teacher", "admin"
  description  String?
  permissions  Permission[]
  teachers     Teacher[]

  @@index([name])
}

// ─── Category ────────────────────────────────────────────────────────────────

model Category {
  id          String      @id @default(uuid())
  name        String
  description String?
  color       String?     // Hex color code for UI display (e.g. "#3B82F6")
  icon        String?     // Icon name or URL
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  courses     Course[]
  exams       Exam[]
  classrooms  Classroom[]

  @@index([name])
}

// ─── LMS Core Domain ────────────────────────────────────────────────────────

enum QuestionType {
  multiple_choice
  true_false
  essay
  code
  fill_blank
  matching
}

model Course {
  id           String        @id @default(uuid())
  title        String
  description  String?
  cover_image  String?
  teacher_id   String
  teacher      Teacher       @relation(fields: [teacher_id], references: [id])
  category_id  String?
  category     Category?     @relation(fields: [category_id], references: [id])
  is_published Boolean       @default(false)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  lessons      Lesson[]
  sections     Section[]
  class_courses ClassCourse[]

  @@index([teacher_id])
  @@index([category_id])
}

model Section {
  id           String   @id @default(uuid())
  title        String
  description  String?
  order        Int      @default(0)
  course_id    String
  course       Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  is_published Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  lessons      Lesson[]

  @@index([course_id])
}

model Lesson {
  id             String               @id @default(uuid())
  title          String
  content        String?
  video_url      String?
  order          Int                  @default(0)
  course_id      String
  course         Course               @relation(fields: [course_id], references: [id], onDelete: Cascade)
  section_id     String?
  section        Section?             @relation(fields: [section_id], references: [id], onDelete: SetNull)
  is_published   Boolean              @default(false)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  attachments    LessonAttachment[]
  progresses     LessonProgress[]
  prerequisites  LessonPrerequisite[] @relation("HasPrerequisites")
  is_prereq_of   LessonPrerequisite[] @relation("IsPrerequisiteOf")

  @@index([course_id])
  @@index([section_id])
}

model LessonPrerequisite {
  lesson_id              String
  lesson                 Lesson @relation("HasPrerequisites", fields: [lesson_id], references: [id], onDelete: Cascade)
  prerequisite_lesson_id String
  prerequisite           Lesson @relation("IsPrerequisiteOf", fields: [prerequisite_lesson_id], references: [id], onDelete: Cascade)

  @@id([lesson_id, prerequisite_lesson_id])
  @@index([lesson_id])
  @@index([prerequisite_lesson_id])
}

model LessonAttachment {
  id         String   @id @default(uuid())
  lesson_id  String
  lesson     Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  name       String
  file_url   String
  file_type  String
  created_at DateTime @default(now())

  @@index([lesson_id])
}

model Exam {
  id           String      @id @default(uuid())
  title        String
  description  String?
  teacher_id   String
  teacher      Teacher     @relation(fields: [teacher_id], references: [id])
  category_id  String?
  category     Category?   @relation(fields: [category_id], references: [id])
  duration     Int?
  pass_score   Float?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  questions    Question[]
  class_exams  ClassExam[]

  @@index([teacher_id])
  @@index([category_id])
}

model Question {
  id             String       @id @default(uuid())
  exam_id        String
  exam           Exam         @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  content        String
  type           QuestionType
  options        Json?
  correct_answer String?
  code_template  String?
  test_cases     Json?
  points         Float        @default(1)
  order          Int          @default(0)

  @@index([exam_id])
}

model Classroom {
  id            String            @id @default(uuid())
  name          String
  description   String?
  code          String            @unique
  category_id   String?
  category      Category?         @relation(fields: [category_id], references: [id])
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  teachers      ClassTeacher[]
  enrollments   ClassEnrollment[]
  class_courses ClassCourse[]
  class_exams   ClassExam[]

  @@map("Class")
  @@index([code])
  @@index([category_id])
}

model ClassTeacher {
  id         String    @id @default(uuid())
  class_id   String
  classroom  Classroom @relation(fields: [class_id], references: [id], onDelete: Cascade)
  teacher_id String
  teacher    Teacher   @relation(fields: [teacher_id], references: [id])
  role       String    @default("assistant")
  joined_at  DateTime  @default(now())

  @@unique([class_id, teacher_id])
  @@index([class_id])
  @@index([teacher_id])
}

model ClassEnrollment {
  id               String           @id @default(uuid())
  class_id         String
  classroom        Classroom        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student_id       String
  student          Student          @relation(fields: [student_id], references: [id])
  enrolled_at      DateTime         @default(now())
  lesson_progresses LessonProgress[]

  @@unique([class_id, student_id])
  @@index([class_id])
  @@index([student_id])
}

model LessonProgress {
  id            String          @id @default(uuid())
  enrollment_id String
  enrollment    ClassEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  lesson_id     String
  lesson        Lesson          @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  is_completed  Boolean         @default(false)
  completed_at  DateTime?
  created_at    DateTime        @default(now())

  @@unique([enrollment_id, lesson_id])
  @@index([enrollment_id])
  @@index([lesson_id])
}

model ClassCourse {
  id          String    @id @default(uuid())
  class_id    String
  classroom   Classroom @relation(fields: [class_id], references: [id], onDelete: Cascade)
  course_id   String
  course      Course    @relation(fields: [course_id], references: [id], onDelete: Cascade)
  assigned_at DateTime  @default(now())

  @@unique([class_id, course_id])
  @@index([class_id])
  @@index([course_id])
}

model ClassExam {
  id          String    @id @default(uuid())
  class_id    String
  classroom   Classroom @relation(fields: [class_id], references: [id], onDelete: Cascade)
  exam_id     String
  exam        Exam      @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  start_time  DateTime?
  end_time    DateTime?
  assigned_at DateTime  @default(now())

  @@unique([class_id, exam_id])
  @@index([class_id])
  @@index([exam_id])
}

// ─── Auth ───────────────────────────────────────────────────────────────────

// Unified refresh token storage for both Student and Teacher
model RefreshToken {
  id         String   @id @default(uuid())
  user_type  String   // "STUDENT" or "TEACHER"
  user_id    String
  token      String   @unique
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([token])
  @@index([user_type, user_id])
}
